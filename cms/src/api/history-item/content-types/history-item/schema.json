{
  "kind": "collectionType",
  "collectionName": "history_items",
  "info": {
    "singularName": "history-item",
    "pluralName": "history-items",
    "displayName": "Історія закладу"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "year": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "text": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "string",
      "default": "history_edu",
      "description": "Назва іконки Material Symbols латиницею. Символ _ є частиною назви, наприклад history_edu. Каталог: https://fonts.google.com/icons",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
